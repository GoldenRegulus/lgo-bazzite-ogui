+static int hid_go_decode_calibration_completion(const struct command_report *cmd_rep,
+						struct hid_go_calibration_result *result)
+{
+	if (cmd_rep->report_id != GO_INPUT_REPORT_ID ||
+	    cmd_rep->id != MCU_CONFIG_DATA || cmd_rep->cmd != GET_DEVICE_STATUS ||
+	    cmd_rep->sub_cmd != GET_CAL_STATUS)
+		return -EINVAL;
+	if (cmd_rep->device_type != LEFT_CONTROLLER &&
+	    cmd_rep->device_type != RIGHT_CONTROLLER)
+		return -EINVAL;
+	if (cmd_rep->data[0] < CALDEV_GYROSCOPE ||
+	    cmd_rep->data[0] > CALDEV_TRIGGER)
+		return -EINVAL;
+	if (cmd_rep->data[1] > 1)
+		return -EINVAL;
+
+	result->device = cmd_rep->device_type;
+	result->module = cmd_rep->data[0];
+	result->status = cmd_rep->data[1] ? CAL_STAT_SUCCESS : CAL_STAT_FAILURE;
+	result->error = get_unaligned_le16(cmd_rep->data + 2);
+	return 0;
+}
+
+static void hid_go_cmd_arm(u8 command, u8 sub_command)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&go_cmd.lock, flags);
+	reinit_completion(&go_cmd.done);
+	go_cmd.pending = true;
+	go_cmd.command = command;
+	go_cmd.sub_command = sub_command;
+	go_cmd.result = 0;
+	spin_unlock_irqrestore(&go_cmd.lock, flags);
+}
+
+static void hid_go_cmd_consume(u8 command, u8 sub_command, int result)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&go_cmd.lock, flags);
+	if (go_cmd.pending && command == go_cmd.command &&
+	    sub_command == go_cmd.sub_command) {
+		go_cmd.pending = false;
+		go_cmd.result = result;
+		complete(&go_cmd.done);
+	}
+	spin_unlock_irqrestore(&go_cmd.lock, flags);
+}
+
+static int hid_go_cmd_finish(long wait_result)
+{
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&go_cmd.lock, flags);
+	if (go_cmd.pending) {
+		go_cmd.pending = false;
+		ret = wait_result < 0 ? wait_result : -ETIMEDOUT;
+	} else {
+		ret = go_cmd.result;
+	}
+	spin_unlock_irqrestore(&go_cmd.lock, flags);
+	return ret;
+}
+
+static int hid_go_build_output_report(u8 *packet, u8 id, u8 command, u8 index,
+				      enum dev_type device, const u8 *data,
+				      size_t len)
+{
+	size_t data_offset = 5;
+
+	if (id == MCU_CONFIG_DATA && command == SET_DPI_CFG &&
+	    index == FPS_MODE_DPI)
+		data_offset = 4;
+	if (len > GO_PACKET_SIZE - data_offset || (len && !data))
+		return -EINVAL;
+
+	memset(packet, 0, GO_PACKET_SIZE);
+	packet[0] = GO_OUTPUT_REPORT_ID;
+	packet[1] = id;
+	packet[2] = command;
+	packet[3] = index;
+	if (data_offset == 5)
+		packet[4] = device;
+	if (len)
+		memcpy(packet + data_offset, data, len);
+	return 0;
+}
+
+static int hid_go_send_output_report(struct hid_device *hdev, u8 *packet)
+{
+	int ret;
+
+	ret = hid_hw_output_report(hdev, packet, GO_PACKET_SIZE);
+	if (ret != GO_PACKET_SIZE)
+		return ret < 0 ? ret : -EIO;
+	return 0;
+}
 
