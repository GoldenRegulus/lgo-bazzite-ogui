+static int lwmi_fan_parse_curve(const char *buf, struct lenovo_fan_curve *curve,
+				u16 max)
+{
+	unsigned int speed[LENOVO_FAN_CURVE_POINTS];
+	char extra;
+	int i;
+	int parsed;
+
+	parsed = sscanf(buf, "%u %u %u %u %u %u %u %u %u %u %c",
+			&speed[0], &speed[1], &speed[2], &speed[3], &speed[4],
+			&speed[5], &speed[6], &speed[7], &speed[8], &speed[9],
+			&extra);
+	if (parsed != LENOVO_FAN_CURVE_POINTS)
+		return -EINVAL;
+
+	for (i = 0; i < LENOVO_FAN_CURVE_POINTS; i++) {
+		if (speed[i] > max)
+			return -ERANGE;
+		curve->speed[i] = speed[i];
+	}
+
+	return lenovo_fan_curve_user_valid(curve, max) ? 0 : -ERANGE;
+}
