+static int lwmi_fan_get_curve(struct lwmi_fan_priv *priv,
+			      struct lenovo_fan_curve *curve)
+{
+	u8 input[] = { 1, 1 };
+	struct wmi_buffer in = {
+		.length = sizeof(input),
+		.data = input,
+	};
+	struct wmi_buffer out = {};
+	int ret;
+
+	ret = wmidev_invoke_method(priv->wdev, 0, LENOVO_FAN_METHOD_GET_CURVE,
+				   &in, &out, LENOVO_FAN_CURVE_REPLY_SIZE);
+	if (ret)
+		return ret;
+
+	ret = lenovo_fan_curve_parse_reply(out.data, out.length,
+					   priv->handheld->curve_max, curve);
+	kfree(out.data);
+
+	return ret;
+}
+
+static int lwmi_fan_set_curve(struct lwmi_fan_priv *priv,
+			      const struct lenovo_fan_curve *curve)
+{
+	u8 buffer[LENOVO_FAN_CURVE_WRITE_SIZE] = {};
+	struct wmi_buffer in = {
+		.length = sizeof(buffer),
+		.data = buffer,
+	};
+
+	lenovo_fan_curve_serialize(curve, buffer);
+
+	return wmidev_invoke_procedure(priv->wdev, 0, LENOVO_FAN_METHOD_SET_CURVE,
+					&in);
+}
