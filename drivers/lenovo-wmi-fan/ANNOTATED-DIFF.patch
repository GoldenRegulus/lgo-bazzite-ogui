+/* ======== Fan Method (supported Legion Go handhelds only) ======== */
+
+static int lwmi_fan_get_curve(struct lwmi_fan_priv *priv,
+			      struct lenovo_fan_curve *curve)
+{
+	u8 input[] = { 1, 1 };
+	struct wmi_buffer in = {
+		.length = sizeof(input),
+		.data = input,
+	};
+	struct wmi_buffer out = {};
+	int ret;
+
+	ret = wmidev_invoke_method(priv->wdev, 0, LENOVO_FAN_METHOD_GET_CURVE,
+				   &in, &out, LENOVO_FAN_CURVE_REPLY_SIZE);
+	if (ret)
+		return ret;
+
+	ret = lenovo_fan_curve_parse_reply(out.data, out.length,
+					   priv->handheld->curve_max, curve);
+	kfree(out.data);
+
+	return ret;
+}
+
+static int lwmi_fan_set_curve(struct lwmi_fan_priv *priv,
+			      const struct lenovo_fan_curve *curve)
+{
+	u8 buffer[LENOVO_FAN_CURVE_WRITE_SIZE] = {};
+	struct wmi_buffer in = {
+		.length = sizeof(buffer),
+		.data = buffer,
+	};
+
+	lenovo_fan_curve_serialize(curve, buffer);
+
+	return wmidev_invoke_procedure(priv->wdev, 0, LENOVO_FAN_METHOD_SET_CURVE,
+					&in);
+}
+
+static ssize_t fan_curve_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct lwmi_fan_priv *priv = dev_get_drvdata(dev);
+	struct lenovo_fan_curve curve;
+	ssize_t length = 0;
+	int ret;
+
+	mutex_lock(&priv->lock);
+	ret = priv->removing ? -ENODEV : lwmi_fan_get_curve(priv, &curve);
+	if (!ret)
+		length = sysfs_emit(buf, "%u %u %u %u %u %u %u %u %u %u\n",
+				    curve.speed[0], curve.speed[1], curve.speed[2],
+				    curve.speed[3], curve.speed[4], curve.speed[5],
+				    curve.speed[6], curve.speed[7], curve.speed[8],
+				    curve.speed[9]);
+	mutex_unlock(&priv->lock);
+
+	return ret ? ret : length;
+}
+
+static int lwmi_fan_parse_curve(const char *buf, struct lenovo_fan_curve *curve,
+				u16 max)
+{
+	unsigned int speed[LENOVO_FAN_CURVE_POINTS];
+	char extra;
+	int i;
+	int parsed;
+
+	parsed = sscanf(buf, "%u %u %u %u %u %u %u %u %u %u %c",
+			&speed[0], &speed[1], &speed[2], &speed[3], &speed[4],
+			&speed[5], &speed[6], &speed[7], &speed[8], &speed[9],
+			&extra);
+	if (parsed != LENOVO_FAN_CURVE_POINTS)
+		return -EINVAL;
+
+	for (i = 0; i < LENOVO_FAN_CURVE_POINTS; i++) {
+		if (speed[i] > max)
+			return -ERANGE;
+		curve->speed[i] = speed[i];
+	}
+
+	return lenovo_fan_curve_user_valid(curve, max) ? 0 : -ERANGE;
+}
+
+static ssize_t fan_curve_store(struct device *dev,
+			       struct device_attribute *attr, const char *buf,
+			       size_t count)
+{
+	struct lwmi_fan_priv *priv = dev_get_drvdata(dev);
+	struct lenovo_fan_curve curve;
+	int ret;
+
+	ret = lwmi_fan_parse_curve(buf, &curve, priv->handheld->curve_max);
+	if (ret)
+		return ret;
+
+	mutex_lock(&priv->lock);
+	ret = priv->removing ? -ENODEV : lwmi_fan_set_curve(priv, &curve);
+	mutex_unlock(&priv->lock);
+
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(fan_curve);
+
+static struct attribute *lwmi_fan_attrs[] = {
+	&dev_attr_fan_curve.attr,
+	NULL,
+};
+
+static const struct attribute_group lwmi_fan_group = {
+	.attrs = lwmi_fan_attrs,
+};
+
+static int lwmi_fan_probe(struct wmi_device *wdev)
+{
+	const struct lenovo_handheld_dmi *handheld;
+	const char *vendor;
+	const char *product_name;
+	const char *product_version;
+	struct lwmi_fan_priv *priv;
+
+	vendor = dmi_get_system_info(DMI_SYS_VENDOR);
+	product_name = dmi_get_system_info(DMI_PRODUCT_NAME);
+	product_version = dmi_get_system_info(DMI_PRODUCT_VERSION);
+	handheld = lenovo_handheld_find(vendor, product_name, product_version);
+	if (!handheld)
+		return -ENODEV;
+
+	priv = devm_kzalloc(&wdev->dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	priv->interface.type = LWMI_WMI_FAN_METHOD;
+	priv->wdev = wdev;
+	priv->handheld = handheld;
+	mutex_init(&priv->lock);
+	dev_set_drvdata(&wdev->dev, priv);
+
+	return devm_device_add_group(&wdev->dev, &lwmi_fan_group);
+}
+
+static void lwmi_fan_remove(struct lwmi_fan_priv *priv)
+{
+	mutex_lock(&priv->lock);
+	priv->removing = true;
+	mutex_unlock(&priv->lock);
+}
