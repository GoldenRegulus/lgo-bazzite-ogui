+/* ======== Full Speed (supported Legion Go handhelds only) ======== */
+
+static int lwmi_om_fan_fullspeed_get(struct lwmi_om_priv *priv, bool *enabled)
+{
+	struct wmi_method_args_32 args = {
+		.arg0 = LWMI_ATTR_ID_FAN_FULLSPEED,
+	};
+	u32 value;
+	int ret;
+
+	ret = lwmi_dev_evaluate_int(priv->wdev, 0x0, LWMI_FEATURE_VALUE_GET,
+				    (u8 *)&args, sizeof(args), &value);
+	if (ret)
+		return ret;
+
+	return lenovo_fan_fullspeed_parse(value, enabled);
 }
 
+static int lwmi_om_fan_fullspeed_set(struct lwmi_om_priv *priv, bool enabled)
+{
+	struct wmi_method_args_32 args = {
+		.arg0 = LWMI_ATTR_ID_FAN_FULLSPEED,
+		.arg1 = enabled,
+	};
+
+	return lwmi_dev_evaluate_int(priv->wdev, 0x0, LWMI_FEATURE_VALUE_SET,
+				     (u8 *)&args, sizeof(args), NULL);
+}
+
+static ssize_t fan_fullspeed_show(struct device *dev,
+				  struct device_attribute *attr, char *buf)
+{
+	struct lwmi_om_priv *priv = dev_get_drvdata(dev);
+	bool enabled;
+	int ret;
+
+	mutex_lock(&priv->fan_fullspeed_lock);
+	ret = priv->fan_fullspeed_removing ? -ENODEV :
+		lwmi_om_fan_fullspeed_get(priv, &enabled);
+	mutex_unlock(&priv->fan_fullspeed_lock);
+	if (ret)
+		return ret;
+
+	return sysfs_emit(buf, "%u\n", enabled);
+}
+
+static ssize_t fan_fullspeed_store(struct device *dev,
+				   struct device_attribute *attr, const char *buf,
+				   size_t count)
+{
+	struct lwmi_om_priv *priv = dev_get_drvdata(dev);
+	unsigned int value;
+	int ret;
+
+	ret = kstrtouint(buf, 10, &value);
+	if (ret)
+		return ret;
+	if (value > 1)
+		return -EINVAL;
+
+	mutex_lock(&priv->fan_fullspeed_lock);
+	ret = priv->fan_fullspeed_removing ? -ENODEV :
+		lwmi_om_fan_fullspeed_set(priv, value);
+	mutex_unlock(&priv->fan_fullspeed_lock);
+
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(fan_fullspeed);
+
+static void lwmi_om_fan_fullspeed_add(struct lwmi_om_priv *priv)
+{
+	int ret;
+
+	if (!priv->handheld_supported)
+		return;
+
+	ret = device_create_file(&priv->wdev->dev, &dev_attr_fan_fullspeed);
+	if (!ret)
+		priv->fan_fullspeed_added = true;
+}
+
+static void lwmi_om_fan_fullspeed_remove(struct lwmi_om_priv *priv)
+{
+	if (!priv->fan_fullspeed_added)
+		return;
+
+	mutex_lock(&priv->fan_fullspeed_lock);
+	priv->fan_fullspeed_removing = true;
+	mutex_unlock(&priv->fan_fullspeed_lock);
+
+	device_remove_file(&priv->wdev->dev, &dev_attr_fan_fullspeed);
+	priv->fan_fullspeed_added = false;
+}
